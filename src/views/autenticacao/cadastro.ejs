<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro</title>
    <link rel="stylesheet" href="/css/auth.css">
    <link rel="icon" href="/assets/icons/favicon.png">
</head>
<body>
    <div class="auth-container">
        <div class="auth-logo">
            <img src="/assets/icons/favicon.png" alt="Greenduino" width="85" height="85">
        </div>
        <h1 class="auth-title">Crie sua conta no Greenduino</h1>
        
        <div class="auth-card">
            <form action="/usuario/cadastro" method="post">
                <div class="input-group">
                    <label for="nome">Nome completo</label>
                    <input name="nome"  type="text" id="nome" required autofocus>
                </div>

                <div class="input-group">
                    <label for="email">E-mail</label>
                    <input name="email" type="email" id="email" required>
                </div>

                <div class="input-group">
                    <label for="telefone">Telefone</label>
                    <input name="telefone" type="text" id="telefone" required>
                </div>

                <div class="input-group">
                    <label for="senha">Senha</label>
                    <input name="senha" type="password" id="senha" required>
                </div>
                
                <div class="input-group">
                    <label for="confirmarSenha">Confirmar Senha</label>
                    <input name="confirmarSenha" type="password" id="confirmarSenha" required>
                </div>
                
                <button type="submit" class="btn-auth-submit">Cadastrar</button>
            </form>
        </div>
        
        <div class="auth-redirect">
            Já tem uma conta? <a href="/login">Entrar</a>.
        </div>
    </div>
</body>
</html>